+def _local_parquet(data):
+    """Local parquet files named by a path, directory or glob, else [] for a Hugging Face id."""
+    import glob
+    path = os.path.expanduser(data)
+    if os.path.isdir(path):
+        return sorted(glob.glob(os.path.join(path, "**", "*.parquet"), recursive=True))
+    files = sorted(glob.glob(path))
+    if not files and (glob.has_magic(path) or path.startswith((".", os.sep))):
+        raise FileNotFoundError(f"no parquet files match {data}")
+    return files
+
+
+def _count_rows(data):
+    """Rows in local parquet (read from the file footers), else the SYNTH estimate."""
+    files = _local_parquet(data)
+    if not files:
+        return _SYNTH_ROWS
+    import pyarrow.parquet as pq
+    return sum(pq.ParquetFile(f).metadata.num_rows for f in files)
+
+
+def _open_stream(data):
